# Core API settings for docker-compose.prod.yml (copy to deploy/core.env).
# DATABASE_URL, AI_API_URL, CORE_API_URL, WEB_ORIGIN, SUPABASE_URL, its JWT
# issuer, INTERNAL_SERVICE_TOKEN, PORT and NODE_ENV are set by the compose file.

DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000

# AI ranking waits this long before using deterministic picks. Ranking takes
# roughly 9s at the median on Gemini Flash-Lite.
AI_RANKING_TIMEOUT_MS=25000

PROGRESS_ENABLED=true
MEMORY_GENERATION_ENABLED=true
MEMORY_RAG_ENABLED=true

# Provider adapters (all enabled by default).
PROVIDER_CODEFORCES_ENABLED=true
PROVIDER_CODECHEF_ENABLED=true
PROVIDER_LEETCODE_ENABLED=true
CODEFORCES_MIN_REQUEST_INTERVAL_MS=2100
PROVIDER_ACTIVITY_MIN_REFRESH_INTERVAL_MS=900000

# A visit re-syncs linked Codeforces/CodeChef/LeetCode accounts last synced
# longer ago than this many minutes (queued work runs while a page is open).
PROVIDER_ACTIVE_SYNC_STALE_MINUTES=60
