# Copy to the repository root as `.env` for docker compose variable substitution.
# Never commit the filled-in file.

# Public HTTPS origin users open (after your TLS proxy). Also used for CORS,
# the Supabase email callback, and the browser connector's API origin.
PUBLIC_SITE_URL=https://app.example.com
WEB_PORT=8080
IMAGE_TAG=latest

POSTGRES_USER=algomemtor
POSTGRES_DB=algomemtor
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Supabase project URL and its publishable (browser-safe) key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Shared secret between the core API and the AI API. Generate with:
# openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=

# Optional store listings for the browser connector.
CHROME_EXTENSION_URL=
FIREFOX_EXTENSION_URL=
