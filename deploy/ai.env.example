# AI API settings for docker-compose.prod.yml (copy to deploy/ai.env).
# DATABASE_URL, CORE_API_URL, WEB_ORIGIN, SUPABASE_URL, its JWT issuer,
# INTERNAL_SERVICE_TOKEN, PORT and APP_ENV are set by the compose file.


# Gemini powers ranking, memory, embeddings and web grounding. Use a paid
# tier in production: free-tier daily limits cause "Coach unavailable" turns.
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# Optional: route lighter coach turns to Qwen on Groq; each provider retries
# on the other when one fails.
COACH_HYBRID_ENABLED=false
GROQ_API_KEY=
COACH_GEMINI_MODEL=gemini-3.5-flash-lite
COACH_GROQ_MODEL=qwen/qwen3.8-27b

# Keep the coach within your provider's requests-per-minute quota (0 = no cap).
COACH_MODEL_REQUESTS_PER_MINUTE=0
COACH_AGENT_ENABLED=true
COACH_AGENT_TIMEOUT_SECONDS=75

MEMORY_GENERATION_ENABLED=true
MEMORY_RAG_ENABLED=true
COACH_KNOWLEDGE_RAG_ENABLED=true
COACH_WEB_GROUNDING_ENABLED=true
INTERNAL_RATE_LIMIT_PER_MINUTE=120
