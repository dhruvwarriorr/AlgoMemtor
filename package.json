{
  "name": "mentorforge",
  "version": "0.1.0",
  "private": true,
  "description": "A persistent AI coding coach for DSA and competitive programming.",
  "workspaces": [
    "apps/web",
    "apps/core-api",
    "packages/shared-contracts"
  ],
  "scripts": {
    "dev": "concurrently -n WEB,CORE,AI -c cyan,green,magenta \"npm:dev:web\" \"npm:dev:core\" \"npm:dev:ai\"",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:core": "npm --prefix apps/core-api run dev",
    "dev:ai": "cd apps/ai-api && uv run fastapi dev app/main.py --port 8000",
    "build": "npm run build:web && npm run build:core",
    "build:web": "npm --prefix apps/web run build",
    "build:core": "npm --prefix apps/core-api run build",
    "typecheck": "npm run typecheck:web && npm run typecheck:core",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "typecheck:core": "npm --prefix apps/core-api run typecheck",
    "lint": "npm --prefix apps/web run lint",
    "format": "npm --prefix apps/web run format",
    "format:check": "npm --prefix apps/web run format:check"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "typescript": "~6.0.2"
  },
  "license": "MIT"
}
