{
  "name": "algomemtor",
  "version": "0.1.0",
  "private": true,
  "description": "An AI-guided navigator for discovering external DSA and competitive-programming problems.",
  "workspaces": [
    "apps/web",
    "packages/shared-contracts"
  ],
  "scripts": {
    "dev": "concurrently -n WEB,AI -c cyan,magenta \"npm:dev:web\" \"npm:dev:ai\"",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:ai": "cd apps/ai-api && uv run fastapi dev app/main.py --port 8000",
    "ai:embeddings:reindex": "uv run --project apps/ai-api python apps/ai-api/scripts/reindex_embeddings.py",
    "db:up": "docker-compose up -d postgres",
    "db:logs": "docker-compose logs -f postgres",
    "db:down": "docker-compose down",
    "db:migrate": "npm run db:migrate:core && npm run db:migrate:ai",
    "db:migrate:core": "npm --prefix apps/web run prisma:migrate:deploy",
    "db:migrate:ai": "cd apps/ai-api && uv run --env-file .env alembic upgrade head",
    "db:seed": "npm --prefix apps/web run prisma:seed",
    "db:copy-from-neon": "bash scripts/copy-neon-to-supabase.sh",
    "build": "npm run build:contracts && npm run build:extension && npm run build:web",
    "build:contracts": "npm --prefix packages/shared-contracts run build",
    "build:web": "npm --prefix apps/web run build",
    "build:extension": "npm --prefix apps/browser-extension run build",
    "typecheck": "npm run typecheck:contracts && npm run typecheck:web && npm run typecheck:extension",
    "typecheck:contracts": "npm --prefix packages/shared-contracts run typecheck",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "typecheck:extension": "npm --prefix apps/browser-extension run typecheck",
    "lint": "npm --prefix apps/web run lint",
    "format": "npm --prefix apps/web run format",
    "format:check": "npm --prefix apps/web run format:check"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "typescript": "~6.0.2"
  },
  "license": "MIT"
}
