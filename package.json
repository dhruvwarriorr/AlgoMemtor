{
  "name": "algomemtor",
  "version": "0.1.0",
  "private": true,
  "description": "An AI-guided navigator for discovering external DSA and competitive-programming problems.",
  "workspaces": [
    "apps/web",
    "apps/core-api",
    "packages/shared-contracts"
  ],
  "scripts": {
    "dev": "concurrently -n WEB,CORE,AI,MEMORY,PROVIDER -c cyan,green,magenta,blue,yellow \"npm:dev:web\" \"npm:dev:core\" \"npm:dev:ai\" \"npm:dev:worker\" \"npm:dev:provider-worker\"",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:core": "npm --prefix apps/core-api run dev",
    "dev:ai": "cd apps/ai-api && uv run fastapi dev app/main.py --port 8000",
    "dev:worker": "npm --prefix apps/core-api run dev:worker",
    "dev:provider-worker": "npm --prefix apps/core-api run dev:provider-worker",
    "db:up": "docker-compose up -d postgres",
    "db:logs": "docker-compose logs -f postgres",
    "db:down": "docker-compose down",
    "db:migrate": "npm run db:migrate:core && npm run db:migrate:ai",
    "db:migrate:core": "npm --prefix apps/core-api run prisma:migrate:deploy",
    "db:migrate:ai": "cd apps/ai-api && uv run --env-file .env alembic upgrade head",
    "db:seed": "npm --prefix apps/core-api run prisma:seed",
    "build": "npm run build:contracts && npm run build:extension && npm run build:web && npm run build:core",
    "build:contracts": "npm --prefix packages/shared-contracts run build",
    "build:web": "npm --prefix apps/web run build",
    "build:core": "npm --prefix apps/core-api run build",
    "build:extension": "npm --prefix apps/browser-extension run build",
    "typecheck": "npm run typecheck:contracts && npm run typecheck:web && npm run typecheck:core && npm run typecheck:extension",
    "typecheck:contracts": "npm --prefix packages/shared-contracts run typecheck",
    "typecheck:web": "npm --prefix apps/web run typecheck",
    "typecheck:core": "npm --prefix apps/core-api run typecheck",
    "typecheck:extension": "npm --prefix apps/browser-extension run typecheck",
    "test": "npm run test:contracts && npm run test:web && npm run test:core && npm run test:extension",
    "test:contracts": "npm --prefix packages/shared-contracts test",
    "test:web": "npm --prefix apps/web test",
    "test:core": "npm --prefix apps/core-api test",
    "test:extension": "npm --prefix apps/browser-extension test",
    "lint": "npm --prefix apps/web run lint",
    "format": "npm --prefix apps/web run format",
    "format:check": "npm --prefix apps/web run format:check"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "typescript": "~6.0.2"
  },
  "license": "MIT"
}
