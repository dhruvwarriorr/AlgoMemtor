APP_ENV=development
PORT=8000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql+psycopg://algomemtor:algomemtor_local@127.0.0.1:5433/algomemtor
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
INTERNAL_SERVICE_TOKEN=
CORE_API_URL=http://localhost:3001

# Development uses exactly one local chat model and one local embedding model.
# No model weights are stored in this repository.
AI_PROVIDER=local
AI_DEVELOPMENT_ALLOW_CLOUD_FALLBACK=false
LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_AI_MODEL=qwen3:8b-q4_K_M
LOCAL_AI_CONTEXT_TOKENS=16384
# off: answer directly (5-10x faster locally); deep: only the deepest turns think.
LOCAL_AI_THINKING=off
# Keep the local chat model loaded between requests (0 leaves Ollama's default).
LOCAL_AI_KEEP_ALIVE_MINUTES=60
# Answer Coach turns in one call over prefetched data instead of a tool agent.
LOCAL_AI_SINGLE_CALL=true
LOCAL_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
LOCAL_EMBEDDING_DIMENSIONS=1024
LOCAL_EMBEDDING_VERSION=qwen3-embedding-0.6b-1024-v1

# Production sets APP_ENV=production and AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=AlgoMemtor
OPENROUTER_APP_URL=
AI_FAST_MODEL=openai/gpt-oss-20b
AI_STRONG_MODEL=openai/gpt-oss-120b
AI_HUGE_CONTEXT_MODEL=qwen/qwen3.8-flash
AI_HUGE_CONTEXT_THRESHOLD_TOKENS=100000
AI_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
AI_EMBEDDING_DIMENSIONS=1024
AI_EMBEDDING_VERSION=qwen3-embedding-8b-1024-v1
AI_WEB_SEARCH_PROVIDER=openrouter
AI_WEB_SEARCH_ENGINE=parallel
AI_WEB_SEARCH_MODEL=openai/gpt-oss-20b
AI_MODEL_ESCALATION_ENABLED=true
AI_MODEL_ESCALATION_MAX_ATTEMPTS=1

# Advisory cost telemetry. It never blocks requests.
AI_BUDGET_TRACKING_ENABLED=true
AI_MONTHLY_SOFT_BUDGET_USD=5.00
AI_BUDGET_WARNING_PERCENT=80
AI_PRICING_VERSION=openrouter-public-2026-09-25
AI_FAST_INPUT_PRICE_PER_MILLION_USD=0.018
AI_FAST_OUTPUT_PRICE_PER_MILLION_USD=0.09
AI_STRONG_INPUT_PRICE_PER_MILLION_USD=0.15
AI_STRONG_OUTPUT_PRICE_PER_MILLION_USD=0.60
AI_HUGE_INPUT_PRICE_PER_MILLION_USD=0.15
AI_HUGE_OUTPUT_PRICE_PER_MILLION_USD=0.47
AI_EMBEDDING_PRICE_PER_MILLION_USD=0.01
AI_WEB_SEARCH_PRICE_PER_REQUEST_USD=0.005

# Left unset: 110 s and 140 s on OpenRouter; with AI_PROVIDER=local they become 300 s
# (requests), 280 s (Coach) and 480 s (mentor tools).
# AI_REQUEST_TIMEOUT_SECONDS=110
AI_MAX_RETRIES=2
RANKING_MAX_OUTPUT_TOKENS=2048
MEMORY_MAX_OUTPUT_TOKENS=2048
UPSOLVE_MAX_OUTPUT_TOKENS=2048
REPORT_MAX_OUTPUT_TOKENS=4096
COACH_MAX_OUTPUT_TOKENS=4096
DOUBT_HELPER_MAX_OUTPUT_TOKENS=8192
SOLUTION_MAX_OUTPUT_TOKENS=16384
MENTOR_MAX_OUTPUT_TOKENS=16384
COACH_THINKING_LEVEL=high
MENTOR_THINKING_LEVEL=low
SOLUTION_THINKING_LEVEL=medium
COACH_AGENT_ENABLED=true
COACH_AGENT_MAX_STEPS=4
COACH_AGENT_TIMEOUT_SECONDS=75
COACH_MODEL_REQUESTS_PER_MINUTE=0
# COACH_RESPONSE_TIMEOUT_SECONDS=140
COACH_LIVE_REFRESH_TIMEOUT_SECONDS=30
MEMORY_GENERATION_ENABLED=true
MEMORY_RAG_ENABLED=true
COACH_KNOWLEDGE_RAG_ENABLED=true
COACH_WEB_GROUNDING_ENABLED=true
COACH_WEB_GROUNDING_TIMEOUT_SECONDS=20
MEMORY_MIN_CONFIDENCE=0.75
MEMORY_MIN_EVIDENCE_STRENGTH=0.75
MEMORY_SIMILARITY_THRESHOLD=0.75
MEMORY_RETRIEVAL_LIMIT=15
EMBEDDING_TIMEOUT_SECONDS=30
INTERNAL_RATE_LIMIT_PER_MINUTE=120

# Safe direct public reader with the existing Jina fallback.
WEB_READER_PROXY_URL=https://r.jina.ai/
WEB_READER_PROXY_API_KEY=
WEB_READER_TIMEOUT_SECONDS=10
WEB_READER_CACHE_SECONDS=1800
WEB_SEARCH_TIMEOUT_SECONDS=40
