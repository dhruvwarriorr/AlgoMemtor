APP_ENV=development
PORT=8000
WEB_ORIGIN=http://localhost:5173
# Supabase transaction pooler (port 6543) in production; local Docker below.
DATABASE_URL=postgresql+psycopg://algomemtor:algomemtor_local@127.0.0.1:5433/algomemtor
SUPABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_TIMEOUT_SECONDS=5
INTERNAL_SERVICE_TOKEN=
# The Next.js web app, which serves the /internal routes the coach calls.
CORE_API_URL=http://localhost:5173

# Every environment, local development included, calls OpenRouter. Use a
# key with a small credit limit for development and keep test prompts short.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=AlgoMemtor
OPENROUTER_APP_URL=
# FAST: cheap structured work (ranking, memory extraction, classification,
# short summaries, simple Coach turns, upsolve picks, search summaries).
AI_FAST_MODEL=openai/gpt-oss-20b
# STRONG: DSA reasoning, debugging, Doubt Helper, Solution Explorer, contest
# analysis, hard Coach turns and long context (over 1M tokens).
AI_STRONG_MODEL=deepseek/deepseek-v4-flash-0731
# Embeddings only (learner memory and knowledge RAG); never answers.
AI_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
AI_EMBEDDING_DIMENSIONS=1024
AI_EMBEDDING_VERSION=qwen3-embedding-8b-1024-v1
AI_WEB_SEARCH_PROVIDER=openrouter
AI_WEB_SEARCH_ENGINE=parallel
AI_WEB_SEARCH_MODEL=openai/gpt-oss-20b
# Hidden reasoning. Off: some hosts ignored the cap and spent the whole budget
# thinking (empty answers). GPT-OSS always reasons at the lowest effort.
AI_REASONING_ENABLED=false
# Fastest OpenRouter host under these list-price ceilings ($/1M tokens).
# The cheapest hosts can be 5x slower; "price" routes cheapest-first.
AI_PROVIDER_SORT=throughput
AI_MAX_INPUT_PRICE_PER_MILLION_USD=0.15
AI_MAX_OUTPUT_PRICE_PER_MILLION_USD=0.40
AI_MODEL_ESCALATION_ENABLED=true
AI_MODEL_ESCALATION_MAX_ATTEMPTS=1

# SQLAlchemy pool per process. Each Vercel instance holds its own pool, so
# keep these small for the Supabase pooler's client limit.
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=1
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_TIMEOUT_SECONDS=5
HEALTH_PROBE_TIMEOUT_SECONDS=3
HEALTH_CACHE_SECONDS=30

# Advisory cost telemetry. It never blocks requests.
AI_BUDGET_TRACKING_ENABLED=true
AI_MONTHLY_SOFT_BUDGET_USD=5.00
AI_BUDGET_WARNING_PERCENT=80
AI_PRICING_VERSION=openrouter-public-2026-09-27
AI_FAST_INPUT_PRICE_PER_MILLION_USD=0.018
AI_FAST_OUTPUT_PRICE_PER_MILLION_USD=0.09
AI_STRONG_INPUT_PRICE_PER_MILLION_USD=0.021
AI_STRONG_OUTPUT_PRICE_PER_MILLION_USD=0.32
AI_EMBEDDING_PRICE_PER_MILLION_USD=0.01
AI_WEB_SEARCH_PRICE_PER_REQUEST_USD=0.005

# Every request must finish inside the Vercel function's 300 s limit.
# AI_REQUEST_TIMEOUT_SECONDS=110
AI_MAX_RETRIES=2
RANKING_MAX_OUTPUT_TOKENS=2048
MEMORY_MAX_OUTPUT_TOKENS=2048
UPSOLVE_MAX_OUTPUT_TOKENS=2048
REPORT_MAX_OUTPUT_TOKENS=4096
COACH_MAX_OUTPUT_TOKENS=4096
DOUBT_HELPER_MAX_OUTPUT_TOKENS=8192
SOLUTION_MAX_OUTPUT_TOKENS=16384
MENTOR_MAX_OUTPUT_TOKENS=16384
COACH_THINKING_LEVEL=high
MENTOR_THINKING_LEVEL=low
SOLUTION_THINKING_LEVEL=medium
COACH_AGENT_ENABLED=true
# true answers Coach turns in one call instead of the tool agent (cheaper).
COACH_SINGLE_CALL=false
COACH_AGENT_MAX_STEPS=4
COACH_AGENT_TIMEOUT_SECONDS=75
COACH_MODEL_REQUESTS_PER_MINUTE=0
# COACH_RESPONSE_TIMEOUT_SECONDS=140
COACH_LIVE_REFRESH_TIMEOUT_SECONDS=30
MEMORY_GENERATION_ENABLED=true
MEMORY_RAG_ENABLED=true
COACH_KNOWLEDGE_RAG_ENABLED=true
COACH_WEB_GROUNDING_ENABLED=true
COACH_WEB_GROUNDING_TIMEOUT_SECONDS=20
MEMORY_MIN_CONFIDENCE=0.75
MEMORY_MIN_EVIDENCE_STRENGTH=0.75
MEMORY_SIMILARITY_THRESHOLD=0.75
MEMORY_RETRIEVAL_LIMIT=15
EMBEDDING_TIMEOUT_SECONDS=30
INTERNAL_RATE_LIMIT_PER_MINUTE=120

# Safe direct public reader with the existing Jina fallback.
WEB_READER_PROXY_URL=https://r.jina.ai/
WEB_READER_PROXY_API_KEY=
WEB_READER_TIMEOUT_SECONDS=10
WEB_READER_CACHE_SECONDS=1800
WEB_SEARCH_TIMEOUT_SECONDS=40
