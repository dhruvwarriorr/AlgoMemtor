# AlgoMemtor web app: the Next.js site and its API (route handlers) in one
# deployment. Copy to .env.local for local development; on Vercel, set these
# as project environment variables.

# --- Browser (inlined into the page at build time; never put secrets here) --
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: store listings for the browser connector, once published. Without
# them, Settings offers the zip builds from /extension/.
NEXT_PUBLIC_CHROME_EXTENSION_URL=
NEXT_PUBLIC_FIREFOX_EXTENSION_URL=

# --- Database: Supabase Postgres ---------------------------------------------
# Runtime: the transaction pooler (Supavisor, port 6543). Serverless functions
# open and close connections constantly, so they must go through the pooler.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local Docker Postgres instead: postgresql://algomemtor:algomemtor_local@127.0.0.1:5433/algomemtor
DATABASE_URL=
# Prisma migrations and the seed only: the session pooler (port 5432, IPv4) or
# the direct connection (db.<project-ref>.supabase.co:5432, IPv6). Migrations
# need a session-level connection. Leave empty to migrate through DATABASE_URL
# (local Docker Postgres).
DATABASE_MIGRATION_URL=
# Connections per function instance. Keep it small: every instance has its
# own pool and the Supabase pooler has a client limit per plan.
DATABASE_POOL_MAX=3
DATABASE_CONNECTION_TIMEOUT_MS=15000
# Interactive Prisma transactions may perform many provider-data writes. These
# limits prevent the five-second Prisma default from aborting them.
DATABASE_TRANSACTION_MAX_WAIT_MS=15000
DATABASE_TRANSACTION_TIMEOUT_MS=60000

# --- Auth (Supabase) -----------------------------------------------------------
SUPABASE_URL=
# https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=

# --- AI service (apps/ai-api, deployed separately) -----------------------------
AI_API_URL=http://localhost:8000
# Shared secret between this app and the AI service (both directions). The AI
# service calls back into /internal/* on this site; set its CORE_API_URL to
# this site's URL.
INTERNAL_SERVICE_TOKEN=
AI_RANKING_TIMEOUT_MS=60000
PROGRESS_ENABLED=true
MEMORY_GENERATION_ENABLED=true
MEMORY_RAG_ENABLED=true

# --- Platform providers --------------------------------------------------------
CODEFORCES_API_BASE_URL=https://codeforces.com/api
PROVIDER_CACHE_TTL_SECONDS=3600
PROVIDER_TIMEOUT_MS=8000
PROVIDER_MAX_ATTEMPTS=2
PROVIDER_CATALOG_CACHE_TTL_SECONDS=21600
PROVIDER_CONTEST_CACHE_TTL_SECONDS=900
PROVIDER_CONTENT_CACHE_TTL_SECONDS=2592000
CODEFORCES_MIN_REQUEST_INTERVAL_MS=2100
CODECHEF_API_BASE_URL=https://www.codechef.com
LEETCODE_GRAPHQL_URL=https://leetcode.com/graphql
PROVIDER_CODEFORCES_ENABLED=true
PROVIDER_CODECHEF_ENABLED=true
PROVIDER_LEETCODE_ENABLED=true
PROVIDER_CODEFORCES_CATALOG_ENABLED=true
PROVIDER_CODEFORCES_CONTENT_ENABLED=true
PROVIDER_CODEFORCES_PROFILE_ENABLED=true
PROVIDER_CODEFORCES_ACTIVITY_ENABLED=true
PROVIDER_CODEFORCES_CONTESTS_ENABLED=true
PROVIDER_CODECHEF_CATALOG_ENABLED=true
PROVIDER_CODECHEF_CONTENT_ENABLED=true
PROVIDER_CODECHEF_PROFILE_ENABLED=true
PROVIDER_CODECHEF_ACTIVITY_ENABLED=true
PROVIDER_CODECHEF_CONTESTS_ENABLED=true
PROVIDER_LEETCODE_CATALOG_ENABLED=true
PROVIDER_LEETCODE_CONTENT_ENABLED=true
PROVIDER_LEETCODE_PROFILE_ENABLED=true
PROVIDER_LEETCODE_ACTIVITY_ENABLED=true
PROVIDER_LEETCODE_CONTESTS_ENABLED=true
CODECHEF_MIN_REQUEST_INTERVAL_MS=1000
LEETCODE_MIN_REQUEST_INTERVAL_MS=1000
CODECHEF_CATALOG_LIMIT=5000
LEETCODE_CATALOG_PAGE_SIZE=100
LEETCODE_CATALOG_MAX_PAGES=10
PROVIDER_ACTIVITY_MIN_REFRESH_INTERVAL_MS=900000

# A visit re-syncs linked Codeforces/CodeChef/LeetCode accounts last synced
# longer ago than this many minutes. There are no worker processes: queued
# syncs and memory jobs run after a response (Next.js `after`) when a
# signed-in page or a connector upload wakes them.
PROVIDER_ACTIVE_SYNC_STALE_MINUTES=60

# --- AI usage limits -------------------------------------------------------------
# Per-learner limits on requests that reach a paid AI model. A 0 disables that
# window. Days reset at midnight UTC. Over the limit the API answers 429
# AI_USAGE_LIMITED with a Retry-After header.
AI_USAGE_LIMITS_ENABLED=true
AI_COACH_REQUESTS_PER_MINUTE=4
AI_COACH_REQUESTS_PER_DAY=40
# Doubt Helper, Solution Explorer, AI Debugger, contest and progress reports.
AI_MENTOR_REQUESTS_PER_MINUTE=3
AI_MENTOR_REQUESTS_PER_DAY=25
AI_RECOMMENDATION_REFRESHES_PER_MINUTE=2
AI_RECOMMENDATION_REFRESHES_PER_DAY=10
# Requests per day across all learners together; 0 means no shared ceiling.
AI_GLOBAL_REQUESTS_PER_DAY=0
