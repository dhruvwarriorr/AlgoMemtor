# Where the browser connector extension uploads. In production, the Render
# Core API URL (https://<service>.onrender.com).
VITE_CORE_API_URL=http://localhost:3001
# Production only: the browser calls the Core API origin directly (the same
# Render URL). Leave empty locally so /api goes through the Vite proxy.
VITE_API_BASE_URL=
VITE_SITE_URL=http://localhost:5173
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_USE_MOCKS=false
# Optional: store listings for the browser connector, once published. Without
# them, Settings offers the zip builds from /extension/.
VITE_CHROME_EXTENSION_URL=
VITE_FIREFOX_EXTENSION_URL=
