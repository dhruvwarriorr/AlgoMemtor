generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["core"]
}

model CoreUser {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId             String                   @unique @map("auth_user_id") @db.Uuid
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  learnerProfile         LearnerProfile?
  providerAccounts       ProviderAccount[]
  bookmarks              Bookmark[]
  recommendationBatches  RecommendationBatch[]
  problemActions         ProblemAction[]
  recommendationFeedback RecommendationFeedback[]
  reflections            ProblemReflection[]
  timerSessions          ProblemTimerSession[]
  aiConsents             LearnerAiConsent[]
  outboxJobs             OutboxJob[]

  @@map("users")
  @@schema("core")
}

model LearnerProfile {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  answers             Json     @db.JsonB
  onboardingCompleted Boolean  @default(true) @map("onboarding_completed")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                CoreUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learner_profiles")
  @@schema("core")
}

model ProviderAccount {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  provider             String    @db.VarChar(32)
  externalHandle       String    @map("external_handle") @db.VarChar(64)
  consentScope         String    @map("consent_scope") @db.VarChar(64)
  verificationStatus   String    @default("not_verified") @map("verification_status") @db.VarChar(32)
  activityAccess       String    @default("not_enabled") @map("activity_access") @db.VarChar(32)
  publicStatsConsentAt DateTime? @map("public_stats_consent_at") @db.Timestamptz(3)
  solvedCount          Int?      @map("solved_count")
  statsComplete        Boolean?  @map("stats_complete")
  statsSource          String?   @map("stats_source") @db.VarChar(64)
  statsFetchedAt       DateTime? @map("stats_fetched_at") @db.Timestamptz(3)
  statsAttemptedAt     DateTime? @map("stats_attempted_at") @db.Timestamptz(3)
  statsErrorCode       String?   @map("stats_error_code") @db.VarChar(64)
  statsErrorRetryable  Boolean?  @map("stats_error_retryable")
  linkedAt             DateTime  @default(now()) @map("linked_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                 CoreUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("provider_accounts")
  @@schema("core")
}

model NormalizedTopic {
  id        String   @id @db.VarChar(96)
  slug      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("normalized_topics")
  @@schema("core")
}

model ExternalProblemCache {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider             String   @db.VarChar(32)
  externalId           String   @map("external_id") @db.VarChar(128)
  title                String   @db.VarChar(512)
  canonicalUrl         String   @map("canonical_url") @db.VarChar(2048)
  providerDifficulty   Json?    @map("provider_difficulty") @db.JsonB
  normalizedDifficulty String?  @map("normalized_difficulty") @db.VarChar(16)
  providerTags         String[] @map("provider_tags")
  normalizedTopics     String[] @map("normalized_topics")
  publicStats          Json?    @map("public_stats") @db.JsonB
  availability         String   @db.VarChar(16)
  fetchedAt            DateTime @map("fetched_at") @db.Timestamptz(3)
  expiresAt            DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([provider, externalId])
  @@index([expiresAt])
  @@index([provider, expiresAt])
  @@index([normalizedTopics], type: Gin)
  @@index([providerTags], type: Gin)
  @@map("external_problem_cache")
  @@schema("core")
}

model Bookmark {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  provider   String   @db.VarChar(32)
  externalId String   @map("external_id") @db.VarChar(128)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user       CoreUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, externalId])
  @@index([userId, createdAt])
  @@map("bookmarks")
  @@schema("core")
}

model RecommendationBatch {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  requestCriteria Json                 @map("request_criteria") @db.JsonB
  rankingMode     String               @map("ranking_mode") @db.VarChar(24)
  rankingVersion  String?              @map("ranking_version") @db.VarChar(64)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  user            CoreUser             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           RecommendationItem[]
  actions         ProblemAction[]

  @@index([userId, createdAt])
  @@map("recommendation_batches")
  @@schema("core")
}

model RecommendationItem {
  id         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batchId    String                   @map("batch_id") @db.Uuid
  provider   String                   @db.VarChar(32)
  externalId String                   @map("external_id") @db.VarChar(128)
  position   Int
  score      Float?
  reason     String                   @db.VarChar(512)
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  batch      RecommendationBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  feedback   RecommendationFeedback[]
  actions    ProblemAction[]

  @@unique([batchId, provider, externalId], map: "recommendation_items_batch_provider_external_id_key")
  @@unique([batchId, position], map: "recommendation_items_batch_position_key")
  @@index([provider, externalId])
  @@map("recommendation_items")
  @@schema("core")
}

model ProblemAction {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String               @map("user_id") @db.Uuid
  provider              String               @db.VarChar(32)
  externalId            String               @map("external_id") @db.VarChar(128)
  actionType            String               @map("action_type") @db.VarChar(32)
  learnerStatus         String?              @map("learner_status") @db.VarChar(16)
  evidenceSource        String?              @map("evidence_source") @db.VarChar(32)
  recommendationBatchId String?              @map("recommendation_batch_id") @db.Uuid
  recommendationItemId  String?              @map("recommendation_item_id") @db.Uuid
  sourceContext         String?              @map("source_context") @db.VarChar(64)
  occurredAt            DateTime             @default(now()) @map("occurred_at") @db.Timestamptz(3)
  user                  CoreUser             @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendationBatch   RecommendationBatch? @relation(fields: [recommendationBatchId], references: [id], onDelete: SetNull)
  recommendationItem    RecommendationItem?  @relation(fields: [recommendationItemId], references: [id], onDelete: SetNull)

  @@index([userId, provider, externalId, occurredAt])
  @@index([userId, actionType, occurredAt])
  @@index([recommendationBatchId])
  @@index([recommendationItemId])
  @@map("problem_actions")
  @@schema("core")
}

model ProblemReflection {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String   @map("user_id") @db.Uuid
  provider               String   @db.VarChar(32)
  externalId             String   @map("external_id") @db.VarChar(128)
  perceivedDifficulty    String   @map("perceived_difficulty") @db.VarChar(16)
  note                   String?  @db.VarChar(1000)
  statusActionId         String?  @map("status_action_id") @db.Uuid
  supersedesReflectionId String?  @map("supersedes_reflection_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user                   CoreUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider, externalId, createdAt])
  @@index([userId, createdAt])
  @@map("problem_reflections")
  @@schema("core")
}

model ProblemTimerSession {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  provider           String    @db.VarChar(32)
  externalId         String    @map("external_id") @db.VarChar(128)
  state              String    @db.VarChar(16)
  durationSeconds    Int       @default(0) @map("duration_seconds")
  startedAt          DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  lastResumedAt      DateTime? @map("last_resumed_at") @db.Timestamptz(3)
  pausedAt           DateTime? @map("paused_at") @db.Timestamptz(3)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(3)
  requiresResolution Boolean   @default(false) @map("requires_resolution")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               CoreUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider, externalId, createdAt])
  @@index([userId, state])
  @@map("problem_timer_sessions")
  @@schema("core")
}

model LearnerAiConsent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  enabled       Boolean
  policyVersion String   @map("policy_version") @db.VarChar(64)
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  user          CoreUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@map("learner_ai_consents")
  @@schema("core")
}

model OutboxJob {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  jobType        String    @map("job_type") @db.VarChar(64)
  evidenceType   String    @map("evidence_type") @db.VarChar(64)
  evidenceId     String?   @map("evidence_id") @db.Uuid
  evidenceIds    Json?     @map("evidence_ids") @db.JsonB
  problemProvider String?  @map("problem_provider") @db.VarChar(32)
  problemExternalId String? @map("problem_external_id") @db.VarChar(128)
  idempotencyKey String    @unique @map("idempotency_key") @db.VarChar(160)
  status         String    @default("pending") @db.VarChar(16)
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  safeErrorCode  String?   @map("safe_error_code") @db.VarChar(64)
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           CoreUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@map("outbox_jobs")
  @@schema("core")
}

model RecommendationFeedback {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  recommendationItemId String             @map("recommendation_item_id") @db.Uuid
  usefulness           String?            @db.VarChar(16)
  perceivedDifficulty  String?            @map("perceived_difficulty") @db.VarChar(24)
  notes                String?            @db.Text
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                 CoreUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendationItem   RecommendationItem @relation(fields: [recommendationItemId], references: [id], onDelete: Cascade)

  @@unique([userId, recommendationItemId], map: "recommendation_feedback_user_item_key")
  @@index([userId, createdAt])
  @@index([recommendationItemId])
  @@map("recommendation_feedback")
  @@schema("core")
}
