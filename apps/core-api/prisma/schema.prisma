generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Explicit so generation does not depend on finding tsconfig.json (for
  // example in a Docker build stage); compiled output must import `.js`.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["core"]
}

model CoreUser {
  id                     String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId             String                      @unique @map("auth_user_id") @db.Uuid
  createdAt              DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  learnerProfile         LearnerProfile?
  providerAccounts       ProviderAccount[]
  connectorTokens        ConnectorToken[]
  activityDigest         LearnerActivityDigest?
  activityChanges        LearnerActivityChange[]
  bookmarks              Bookmark[]
  recommendationBatches  RecommendationBatch[]
  problemActions         ProblemAction[]
  recommendationFeedback RecommendationFeedback[]
  reflections            ProblemReflection[]
  timerSessions          ProblemTimerSession[]
  aiConsents             LearnerAiConsent[]
  outboxJobs             OutboxJob[]
  verifiedActivities     ProviderVerifiedActivity[]
  providerProfiles       ProviderProfileSnapshot[]
  providerSubmissions    ProviderSubmission[]
  solvedObservations     ProviderSolvedObservation[]
  ratingChanges          ProviderRatingChange[]
  contestParticipations  ContestParticipation[]
  syncStates             ProviderSyncState[]
  syncJobs               ProviderSyncJob[]
  coachConversations     CoachConversation[]
  coachProposals         CoachActionProposal[]
  coachRoadmap           CoachRoadmap?
  coachRoadmapRevisions  CoachRoadmapRevision[]
  coachTopicStatuses     CoachTopicStatus[]
  coachTopicStatusEvents CoachTopicStatusEvent[]
  coachPreferences       CoachPreferences?
  coachCheckIns          CoachCheckIn[]
  avatar                 UserAvatar?

  @@map("users")
  @@schema("core")
}

// A learner-uploaded profile picture, resized client-side to a small WebP,
// JPEG or PNG. Deleted with the user.
// The learner's synced-activity summary, recomputed after each sync. The
// coach reads it first; `source_hash` skips recomputation when nothing changed.
model LearnerActivityDigest {
  userId     String   @id @map("user_id") @db.Uuid
  version    String   @db.VarChar(32)
  digest     Json
  sourceHash String   @map("source_hash") @db.Char(64)
  computedAt DateTime @map("computed_at") @db.Timestamptz(3)
  user       CoreUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learner_activity_digests")
  @@schema("core")
}

// A short note describing what changed between two digests. It is the memory
// evidence sent to the AI service, which turns it into learner memories.
model LearnerActivityChange {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  note      String   @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      CoreUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("learner_activity_changes")
  @@schema("core")
}

// Pairing tokens for the learner's browser connector. Only a SHA-256 hash of
// the secret is stored; the secret itself is shown once, at creation.
model ConnectorToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  label      String    @db.VarChar(64)
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  user       CoreUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("connector_tokens")
  @@schema("core")
}

model UserAvatar {
  userId    String   @id @map("user_id") @db.Uuid
  mimeType  String   @map("mime_type")
  data      Bytes
  byteSize  Int      @map("byte_size")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      CoreUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatars")
  @@schema("core")
}

model LearnerProfile {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  answers             Json     @db.JsonB
  onboardingCompleted Boolean  @default(true) @map("onboarding_completed")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                CoreUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learner_profiles")
  @@schema("core")
}

model ProviderAccount {
  id                           String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                       String                      @map("user_id") @db.Uuid
  provider                     String                      @db.VarChar(32)
  externalHandle               String                      @map("external_handle") @db.VarChar(64)
  consentScope                 String                      @map("consent_scope") @db.VarChar(64)
  verificationStatus           String                      @default("not_verified") @map("verification_status") @db.VarChar(32)
  verificationCode             String?                     @map("verification_code") @db.VarChar(16)
  verificationExpiresAt        DateTime?                   @map("verification_expires_at") @db.Timestamptz(3)
  verifiedAt                   DateTime?                   @map("verified_at") @db.Timestamptz(3)
  connectorSyncedAt            DateTime?                   @map("connector_synced_at") @db.Timestamptz(3)
  activityAccess               String                      @default("not_enabled") @map("activity_access") @db.VarChar(32)
  publicStatsConsentAt         DateTime?                   @map("public_stats_consent_at") @db.Timestamptz(3)
  solvedCount                  Int?                        @map("solved_count")
  statsComplete                Boolean?                    @map("stats_complete")
  statsSource                  String?                     @map("stats_source") @db.VarChar(64)
  statsFetchedAt               DateTime?                   @map("stats_fetched_at") @db.Timestamptz(3)
  statsAttemptedAt             DateTime?                   @map("stats_attempted_at") @db.Timestamptz(3)
  statsErrorCode               String?                     @map("stats_error_code") @db.VarChar(64)
  statsErrorRetryable          Boolean?                    @map("stats_error_retryable")
  activityConsentAt            DateTime?                   @map("activity_consent_at") @db.Timestamptz(3)
  activitySyncStatus           String                      @default("not_enabled") @map("activity_sync_status") @db.VarChar(16)
  activityLastAttemptedAt      DateTime?                   @map("activity_last_attempted_at") @db.Timestamptz(3)
  activityLastSucceededAt      DateTime?                   @map("activity_last_succeeded_at") @db.Timestamptz(3)
  activityAcceptedProblemCount Int?                        @map("activity_accepted_problem_count")
  activityComplete             Boolean?                    @map("activity_complete")
  activityErrorCode            String?                     @map("activity_error_code") @db.VarChar(64)
  activityRetryAfter           DateTime?                   @map("activity_retry_after") @db.Timestamptz(3)
  syncEnabled                  Boolean                     @default(true) @map("sync_enabled")
  disconnectedAt               DateTime?                   @map("disconnected_at") @db.Timestamptz(3)
  linkedAt                     DateTime                    @default(now()) @map("linked_at") @db.Timestamptz(3)
  updatedAt                    DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                         CoreUser                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedActivities           ProviderVerifiedActivity[]
  profileSnapshots             ProviderProfileSnapshot[]
  submissions                  ProviderSubmission[]
  solvedObservations           ProviderSolvedObservation[]
  ratingChanges                ProviderRatingChange[]
  contestParticipations        ContestParticipation[]
  syncStates                   ProviderSyncState[]
  syncJobs                     ProviderSyncJob[]

  @@unique([userId, provider, externalHandle], map: "provider_accounts_user_provider_handle_key")
  @@map("provider_accounts")
  @@schema("core")
}

model ProviderVerifiedActivity {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String          @map("user_id") @db.Uuid
  providerAccountId  String          @map("provider_account_id") @db.Uuid
  provider           String          @db.VarChar(32)
  externalId         String          @map("external_id") @db.VarChar(128)
  providerEventId    String          @map("provider_event_id") @db.VarChar(96)
  providerOccurredAt DateTime        @map("provider_occurred_at") @db.Timestamptz(3)
  firstObservedAt    DateTime        @default(now()) @map("first_observed_at") @db.Timestamptz(3)
  lastObservedAt     DateTime        @default(now()) @map("last_observed_at") @db.Timestamptz(3)
  progressActionId   String?         @unique @map("progress_action_id") @db.Uuid
  user               CoreUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerAccount    ProviderAccount @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)
  progressAction     ProblemAction?  @relation(fields: [progressActionId], references: [id], onDelete: SetNull)

  @@unique([providerAccountId, externalId], map: "provider_verified_activity_account_external_key")
  @@unique([providerAccountId, providerEventId])
  @@index([userId, provider, externalId], map: "provider_verified_activity_user_provider_external_idx")
  @@index([userId, providerOccurredAt])
  @@map("provider_verified_activity")
  @@schema("core")
}

model NormalizedTopic {
  id            String   @id @db.VarChar(96)
  slug          String   @unique @db.VarChar(64)
  name          String   @db.VarChar(128)
  prerequisites String[] @default([])
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("normalized_topics")
  @@schema("core")
}

model ExternalProblemCache {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider             String   @db.VarChar(32)
  externalId           String   @map("external_id") @db.VarChar(128)
  title                String   @db.VarChar(512)
  canonicalUrl         String   @map("canonical_url") @db.VarChar(2048)
  providerDifficulty   Json?    @map("provider_difficulty") @db.JsonB
  normalizedDifficulty String?  @map("normalized_difficulty") @db.VarChar(16)
  providerTags         String[] @map("provider_tags")
  normalizedTopics     String[] @map("normalized_topics")
  publicStats          Json?    @map("public_stats") @db.JsonB
  acceptanceRate       Float?   @map("acceptance_rate")
  isPaidOnly           Boolean  @default(false) @map("is_paid_only")
  contentAvailable     Boolean  @default(false) @map("content_available")
  extractionStrategy   String   @default("official_json") @map("extraction_strategy") @db.VarChar(32)
  sourceUrl            String   @default("https://codeforces.com/api/problemset.problems") @map("source_url") @db.VarChar(2048)
  schemaVersion        String   @default("legacy-v1") @map("schema_version") @db.VarChar(64)
  completeness         String   @default("complete") @db.VarChar(16)
  stale                Boolean  @default(false)
  availability         String   @db.VarChar(16)
  fetchedAt            DateTime @map("fetched_at") @db.Timestamptz(3)
  expiresAt            DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([provider, externalId])
  @@index([expiresAt])
  @@index([provider, expiresAt])
  @@index([normalizedTopics], type: Gin)
  @@index([providerTags], type: Gin)
  @@map("external_problem_cache")
  @@schema("core")
}

model ProblemContentCache {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider           String   @db.VarChar(32)
  externalId         String   @map("external_id") @db.VarChar(128)
  title              String   @db.VarChar(512)
  canonicalUrl       String   @map("canonical_url") @db.VarChar(2048)
  statementHtml      String?  @map("statement_html") @db.Text
  statementText      String?  @map("statement_text") @db.Text
  constraints        Json?    @db.JsonB
  examples           Json?    @db.JsonB
  hints              Json?    @db.JsonB
  publicSolutionHtml String?  @map("public_solution_html") @db.Text
  isPaidOnly         Boolean  @default(false) @map("is_paid_only")
  contentAvailable   Boolean  @default(false) @map("content_available")
  extractionStrategy String   @map("extraction_strategy") @db.VarChar(32)
  sourceUrl          String   @map("source_url") @db.VarChar(2048)
  schemaVersion      String   @map("schema_version") @db.VarChar(64)
  completeness       String   @db.VarChar(16)
  availability       String   @db.VarChar(16)
  fetchedAt          DateTime @map("fetched_at") @db.Timestamptz(3)
  expiresAt          DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([provider, externalId])
  @@index([expiresAt])
  @@index([provider, expiresAt])
  @@map("problem_content_cache")
  @@schema("core")
}

model ExternalContest {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider           String    @db.VarChar(32)
  externalId         String    @map("external_id") @db.VarChar(128)
  name               String    @db.VarChar(512)
  canonicalUrl       String    @map("canonical_url") @db.VarChar(2048)
  phase              String?   @db.VarChar(32)
  startsAt           DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt             DateTime? @map("ends_at") @db.Timestamptz(3)
  durationSeconds    Int?      @map("duration_seconds")
  isRated            Boolean?  @map("is_rated")
  status             String    @db.VarChar(16)
  extractionStrategy String    @map("extraction_strategy") @db.VarChar(32)
  sourceUrl          String    @map("source_url") @db.VarChar(2048)
  schemaVersion      String    @map("schema_version") @db.VarChar(64)
  completeness       String    @db.VarChar(16)
  availability       String    @db.VarChar(16)
  fetchedAt          DateTime  @map("fetched_at") @db.Timestamptz(3)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([provider, externalId])
  @@index([provider, startsAt])
  @@index([status, startsAt])
  @@map("external_contests")
  @@schema("core")
}

model ProviderProfileSnapshot {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String          @map("user_id") @db.Uuid
  providerAccountId  String          @map("provider_account_id") @db.Uuid
  provider           String          @db.VarChar(32)
  externalHandle     String          @map("external_handle") @db.VarChar(128)
  displayName        String?         @map("display_name") @db.VarChar(256)
  profileUrl         String          @map("profile_url") @db.VarChar(2048)
  avatarUrl          String?         @map("avatar_url") @db.VarChar(2048)
  rank               String?         @db.VarChar(128)
  globalRank         Int?            @map("global_rank")
  rating             Float?
  solvedCount        Int?            @map("solved_count")
  acceptanceRate     Float?          @map("acceptance_rate")
  languageCounts     Json            @map("language_counts") @db.JsonB
  topicCounts        Json            @map("topic_counts") @db.JsonB
  badges             Json            @db.JsonB
  calendar           Json            @db.JsonB
  completeness       String          @db.VarChar(16)
  extractionStrategy String          @map("extraction_strategy") @db.VarChar(32)
  sourceUrl          String          @map("source_url") @db.VarChar(2048)
  schemaVersion      String          @map("schema_version") @db.VarChar(64)
  fetchedAt          DateTime        @map("fetched_at") @db.Timestamptz(3)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  user               CoreUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerAccount    ProviderAccount @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)

  @@index([userId, provider, fetchedAt])
  @@index([providerAccountId, fetchedAt])
  @@map("provider_profile_snapshots")
  @@schema("core")
}

model ProviderSubmission {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String          @map("user_id") @db.Uuid
  providerAccountId  String          @map("provider_account_id") @db.Uuid
  provider           String          @db.VarChar(32)
  externalId         String          @map("external_id") @db.VarChar(128)
  providerEventId    String          @map("provider_event_id") @db.VarChar(128)
  problemTitle       String?         @map("problem_title") @db.VarChar(512)
  canonicalUrl       String          @map("canonical_url") @db.VarChar(2048)
  verdict            String          @db.VarChar(64)
  language           String?         @db.VarChar(128)
  occurredAt         DateTime?       @map("occurred_at") @db.Timestamptz(3)
  isAccepted         Boolean         @map("is_accepted")
  runtimeMs          Int?            @map("runtime_ms")
  memoryKb           Int?            @map("memory_kb")
  passedTestCount    Int?            @map("passed_test_count")
  completeness       String          @db.VarChar(16)
  extractionStrategy String          @map("extraction_strategy") @db.VarChar(32)
  sourceUrl          String          @map("source_url") @db.VarChar(2048)
  schemaVersion      String          @map("schema_version") @db.VarChar(64)
  fetchedAt          DateTime        @map("fetched_at") @db.Timestamptz(3)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               CoreUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerAccount    ProviderAccount @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)

  @@unique([providerAccountId, providerEventId])
  @@index([userId, provider, occurredAt])
  @@index([providerAccountId, occurredAt])
  @@map("provider_submissions")
  @@schema("core")
}

model ProviderSolvedObservation {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String          @map("user_id") @db.Uuid
  providerAccountId  String          @map("provider_account_id") @db.Uuid
  provider           String          @db.VarChar(32)
  externalId         String          @map("external_id") @db.VarChar(128)
  providerEventId    String?         @map("provider_event_id") @db.VarChar(128)
  canonicalUrl       String          @map("canonical_url") @db.VarChar(2048)
  providerTags       String[]        @default([]) @map("provider_tags")
  normalizedTopics   String[]        @default([]) @map("normalized_topics")
  tagsCheckedAt      DateTime?       @map("tags_checked_at") @db.Timestamptz(3)
  occurredAt         DateTime?       @map("occurred_at") @db.Timestamptz(3)
  firstObservedAt    DateTime        @default(now()) @map("first_observed_at") @db.Timestamptz(3)
  lastObservedAt     DateTime        @default(now()) @map("last_observed_at") @db.Timestamptz(3)
  completeness       String          @db.VarChar(16)
  extractionStrategy String          @map("extraction_strategy") @db.VarChar(32)
  sourceUrl          String          @map("source_url") @db.VarChar(2048)
  schemaVersion      String          @map("schema_version") @db.VarChar(64)
  user               CoreUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerAccount    ProviderAccount @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)

  @@unique([providerAccountId, externalId], map: "provider_solved_observations_account_external_key")
  @@unique([providerAccountId, providerEventId])
  @@index([userId, provider, externalId], map: "provider_solved_observations_user_provider_external_idx")
  @@index([userId, occurredAt])
  @@map("provider_solved_observations")
  @@schema("core")
}

model ProviderRatingChange {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String          @map("user_id") @db.Uuid
  providerAccountId  String          @map("provider_account_id") @db.Uuid
  provider           String          @db.VarChar(32)
  eventId            String          @map("event_id") @db.VarChar(128)
  contestId          String?         @map("contest_id") @db.VarChar(128)
  contestName        String?         @map("contest_name") @db.VarChar(512)
  canonicalUrl       String          @map("canonical_url") @db.VarChar(2048)
  occurredAt         DateTime        @map("occurred_at") @db.Timestamptz(3)
  oldRating          Float           @map("old_rating")
  newRating          Float           @map("new_rating")
  delta              Float
  providerPercentile Float?          @map("provider_percentile")
  completeness       String          @db.VarChar(16)
  extractionStrategy String          @map("extraction_strategy") @db.VarChar(32)
  sourceUrl          String          @map("source_url") @db.VarChar(2048)
  schemaVersion      String          @map("schema_version") @db.VarChar(64)
  user               CoreUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerAccount    ProviderAccount @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)

  @@unique([providerAccountId, eventId])
  @@index([userId, provider, occurredAt])
  @@map("provider_rating_changes")
  @@schema("core")
}

model ContestParticipation {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String          @map("user_id") @db.Uuid
  providerAccountId  String          @map("provider_account_id") @db.Uuid
  provider           String          @db.VarChar(32)
  contestId          String          @map("contest_id") @db.VarChar(128)
  contestName        String?         @map("contest_name") @db.VarChar(512)
  canonicalUrl       String          @map("canonical_url") @db.VarChar(2048)
  rank               Int?
  score              Float?
  ratingChange       Float?          @map("rating_change")
  oldRating          Float?          @map("old_rating")
  newRating          Float?          @map("new_rating")
  attendedAt         DateTime?       @map("attended_at") @db.Timestamptz(3)
  extractionStrategy String          @map("extraction_strategy") @db.VarChar(32)
  sourceUrl          String          @map("source_url") @db.VarChar(2048)
  schemaVersion      String          @map("schema_version") @db.VarChar(64)
  completeness       String          @db.VarChar(16)
  user               CoreUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerAccount    ProviderAccount @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)

  @@unique([providerAccountId, contestId])
  @@index([userId, provider, attendedAt])
  @@map("contest_participations")
  @@schema("core")
}

model ProviderSyncState {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scopeKey          String           @map("scope_key") @db.VarChar(160)
  userId            String?          @map("user_id") @db.Uuid
  providerAccountId String?          @map("provider_account_id") @db.Uuid
  provider          String           @db.VarChar(32)
  capability        String           @db.VarChar(64)
  status            String           @db.VarChar(16)
  cursor            String?          @db.Text
  lastStartedAt     DateTime?        @map("last_started_at") @db.Timestamptz(3)
  lastSucceededAt   DateTime?        @map("last_succeeded_at") @db.Timestamptz(3)
  nextRunAt         DateTime?        @map("next_run_at") @db.Timestamptz(3)
  attempts          Int              @default(0)
  lastErrorCode     String?          @map("last_error_code") @db.VarChar(64)
  completeness      String           @db.VarChar(16)
  stale             Boolean          @default(false)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  user              CoreUser?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerAccount   ProviderAccount? @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)

  @@unique([scopeKey, provider, capability])
  @@index([provider, capability, nextRunAt])
  @@index([userId, provider, capability])
  @@map("provider_sync_states")
  @@schema("core")
}

